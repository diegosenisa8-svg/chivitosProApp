generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  /// Sube al cambiar la contraseña: invalida los tokens ya emitidos.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Restaurant {
  id           Int      @id @default(1)
  name         String
  address      String
  city         String
  country      String
  open         Boolean  @default(true)
  distanceKm   Float    @default(0)
  delivery     Boolean  @default(true)
  takeaway     Boolean  @default(true)
  currency     String   @default("UYU")
  whatsapp     String
  logo         String
  hero         String
  mapEmbed     String
  lat          Float
  lng          Float
  hoursLabel   String   @default("Lun–Dom 11:30 a 00:00")
  etaMin       Int      @default(35)
  etaMax       Int      @default(55)
  deliveryFee  Float    @default(80)
  minOrder     Float    @default(250)
  phone        String   @default("")
  settings     Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

model Category {
  id                   String                       @id
  name                 String
  subtitle             String                       @default("")
  banner               String
  sortOrder            Int                          @default(0)
  items                Product[]
  modifierAssignments  CategoryModifierAssignment[]
}

model ModifierLibraryGroup {
  id            String                       @id @default(cuid())
  name          String
  required      Boolean                      @default(false)
  min           Int                          @default(0)
  max           Int                          @default(1)
  allowQuantity Boolean                      @default(false)
  sortOrder     Int                          @default(0)
  options       ModifierLibraryOption[]
  categories    CategoryModifierAssignment[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
}

model ModifierLibraryOption {
  id        String               @id @default(cuid())
  name      String
  price     Float                @default(0)
  sortOrder Int                  @default(0)
  groupId   String
  group     ModifierLibraryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model CategoryModifierAssignment {
  categoryId     String
  libraryGroupId String
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  libraryGroup   ModifierLibraryGroup @relation(fields: [libraryGroupId], references: [id], onDelete: Cascade)

  @@id([categoryId, libraryGroupId])
}

model Product {
  id          String           @id
  name        String
  description String           @default("")
  price       Float
  priceMax    Float?
  image       String
  sortOrder   Int              @default(0)
  available   Boolean          @default(true)
  featured    Boolean          @default(false)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifiers   ModifierGroup[]
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

model ModifierGroup {
  id            String           @id @default(cuid())
  externalId    String
  name          String
  required      Boolean          @default(false)
  min           Int              @default(0)
  max           Int              @default(1)
  allowQuantity Boolean          @default(false)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options       ModifierOption[]

  @@unique([productId, externalId])
  @@index([externalId])
}

model ModifierOption {
  id         String        @id @default(cuid())
  externalId String
  name       String
  price      Float         @default(0)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalId])
}

model CustomerAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Customer {
  id           String   @id @default(cuid())
  phoneKey     String   @unique
  phone        String
  name         String
  orderCount   Int      @default(1)
  lastOrderAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastOrderAt])
}

model Order {
  id                String           @id @default(cuid())
  status            String           @default("pending")
  customerName      String?
  phone             String?
  notes             String?
  fulfillment       String           @default("delivery")
  address           String?
  payment           String           @default("efectivo")
  schedule          String           @default("now")
  scheduleTime      String?
  subtotal          Float            @default(0)
  discount          Float            @default(0)
  deliveryFee       Float            @default(0)
  total             Float
  currency          String           @default("UYU")
  payload           Json
  /// Coordenada reportada por el navegador del cliente (solo delivery).
  lat               Float?
  lng               Float?
  /// Precisión del GPS en metros, tal como la informó el dispositivo.
  locationAccuracy  Float?
  /// Zona resuelta por el servidor a partir de la coordenada, no elegida por el cliente.
  deliveryZoneId    String?
  deliveryZoneName  String?
  /// La coordenada cayó fuera de todas las zonas activas.
  outOfRange        Boolean          @default(false)
  /// Número de casa o apartamento (obligatorio en delivery).
  addressDetail     String?
  /// Referencia opcional para el repartidor.
  addressReference  String?
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             OrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([customerAccountId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  quantity  Int
  unitPrice Float
  notes     String @default("")
  modifiers Json
  lineTotal Float
  sizeLabel String @default("")

  @@index([orderId])
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
