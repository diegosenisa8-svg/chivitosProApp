generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Restaurant {
  id           Int      @id @default(1)
  name         String
  address      String
  city         String
  country      String
  open         Boolean  @default(true)
  distanceKm   Float    @default(0)
  delivery     Boolean  @default(true)
  takeaway     Boolean  @default(true)
  currency     String   @default("UYU")
  whatsapp     String
  logo         String
  hero         String
  mapEmbed     String
  lat          Float
  lng          Float
  hoursLabel   String   @default("Lun–Dom 11:30 a 00:00")
  etaMin       Int      @default(35)
  etaMax       Int      @default(55)
  deliveryFee  Float    @default(80)
  minOrder     Float    @default(250)
  phone        String   @default("")
  settings     Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id
  name      String
  subtitle  String    @default("")
  banner    String
  sortOrder Int       @default(0)
  items     Product[]
}

model Product {
  id          String           @id
  name        String
  description String           @default("")
  price       Float
  priceMax    Float?
  image       String
  sortOrder   Int              @default(0)
  available   Boolean          @default(true)
  featured    Boolean          @default(false)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifiers   ModifierGroup[]
  updatedAt   DateTime         @updatedAt
}

model ModifierGroup {
  id            String           @id @default(cuid())
  externalId    String
  name          String
  required      Boolean          @default(false)
  min           Int              @default(0)
  max           Int              @default(1)
  allowQuantity Boolean          @default(false)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options       ModifierOption[]

  @@unique([productId, externalId])
}

model ModifierOption {
  id         String        @id @default(cuid())
  externalId String
  name       String
  price      Float         @default(0)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalId])
}

model Customer {
  id           String   @id @default(cuid())
  phoneKey     String   @unique
  phone        String
  name         String
  orderCount   Int      @default(1)
  lastOrderAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  status         String      @default("pending")
  customerName   String?
  phone          String?
  notes          String?
  fulfillment    String      @default("delivery")
  address        String?
  payment        String      @default("efectivo")
  schedule       String      @default("now")
  scheduleTime   String?
  subtotal       Float       @default(0)
  discount       Float       @default(0)
  deliveryFee    Float       @default(0)
  total          Float
  currency       String      @default("UYU")
  payload        Json
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  quantity  Int
  unitPrice Float
  notes     String @default("")
  modifiers Json
  lineTotal Float
  sizeLabel String @default("")
}
